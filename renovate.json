{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>chill-institute/.github:renovate-config"],
  "customManagers": [
    {
      "description": "The harness pins Effect again in versions.ts; setup refuses a mismatch",
      "customType": "regex",
      "managerFilePatterns": ["/^harness/versions\\.ts$/"],
      "matchStrings": ["\\beffect: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "effect",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Playback dependencies require fresh real-client evidence before merge",
      "matchPackageNames": [
        "stremio-addon-sdk",
        "stremio-addon-client",
        "stremio-addon-linter",
        "stremio-web",
        "effect",
        "@effect/platform-node",
        "sharp",
        "@playwright/test",
        "playwright",
        "mcr.microsoft.com/playwright"
      ],
      "automerge": false
    },
    {
      "description": "The browser image must carry the @playwright/test release",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "Playwright"
    },
    {
      "description": "router@1 needs the patched path-to-regexp 0.1.x line; 0.2.x is an older, vulnerable line",
      "matchPackageNames": ["path-to-regexp"],
      "allowedVersions": "<0.2.0"
    },
    {
      "description": "Effect, its Node platform and the harness pin move together",
      "matchPackageNames": [
        "effect",
        "@effect/platform-node",
        "@effect/platform-node-shared"
      ],
      "groupName": "Effect"
    },
    {
      "description": "vite-plus and the vite-plus-core alias behind vite must share a version",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "Vite+"
    }
  ]
}
